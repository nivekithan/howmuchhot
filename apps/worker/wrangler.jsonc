{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "howmuchhot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  "r2_buckets": [{ "binding": "TILES", "bucket_name": "howmuchhot-tiles" }],
  "triggers": { "crons": ["0 */8 * * *"] },
  "containers": [
    {
      "class_name": "TemperatureProcessor",
      "image": "../processor/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
      "constraints": { "regions": ["ENAM"] },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "PROCESSOR", "class_name": "TemperatureProcessor" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TemperatureProcessor"] }],
  "workflows": [
    {
      "name": "howmuchhot-weather-refresh",
      "binding": "WEATHER_REFRESH",
      "class_name": "WeatherRefresh",
    },
  ],
  "observability": { "enabled": true },
}
